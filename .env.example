# DataPilot AI Environment Configuration Example
# Copy this file to .env and configure your optional keys

# Optional LLM API Keys (App works 100% offline using deterministic computation if not configured)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
APP_ENV=development
DEFAULT_THEME=Midnight Dark
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
